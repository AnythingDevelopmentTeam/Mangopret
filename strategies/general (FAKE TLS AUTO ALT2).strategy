{
  "id": "general (FAKE TLS AUTO ALT2)",
  "name": "General (FAKE TLS AUTO ALT2)",
  "description": "Fake,multisplit with badseq, badseq-increment=10000000.",
  "version": "1.0",
  "author": "vesno4null",
  "wf_tcp": "80,443,2053,2083,2087,2096,8443",
  "wf_udp": "443,19294-19344,50000-50100",
  "rules": [
    {
      "name": "UDP 443",
      "filter-udp": "443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=11"
      ]
    },
    {
      "name": "UDP 19294-19344,50000-50100",
      "filter-udp": "19294-19344,50000-50100",
      "filter-l7": "discord,stun",
      "dpi-desync": "fake",
      "dpi-desync-fake-discord": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-fake-stun": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-repeats": "6",
      "lua_desync": [
        "fake:discord={bin}/ACTIVE_DISCORD_UDP.bin:stun={bin}/ACTIVE_DISCORD_UDP.bin:repeats=6"
      ]
    },
    {
      "name": "TCP 2053,2083,2087,2096,8443",
      "filter-tcp": "2053,2083,2087,2096,8443",
      "hostlist-domains": "discord.media",
      "dpi-desync": "fake,multisplit",
      "dpi-desync-split-seqovl": "681",
      "dpi-desync-split-pos": "1",
      "dpi-desync-fooling": "badseq",
      "dpi-desync-badseq-increment": "10000000",
      "dpi-desync-repeats": "8",
      "dpi-desync-split-seqovl-pattern": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-tls-mod": "rnd,dupsid,sni=www.google.com",
      "lua_desync": [
        "fake:tcp_seq=-66000:tls_rnd:tls_dupsid:sni=www.google.com:repeats=8",
        "multisplit:pos=1:seqovl=681:pattern={bin}/tls_clienthello_www_google_com.bin:repeats=8"
      ]
    },
    {
      "name": "TCP 443",
      "filter-tcp": "443",
      "hostlist": "{lists}/list-google.txt",
      "ip-id": "zero",
      "dpi-desync": "fake,multisplit",
      "dpi-desync-split-seqovl": "681",
      "dpi-desync-split-pos": "1",
      "dpi-desync-fooling": "badseq",
      "dpi-desync-badseq-increment": "10000000",
      "dpi-desync-repeats": "8",
      "dpi-desync-split-seqovl-pattern": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-tls-mod": "rnd,dupsid,sni=www.google.com",
      "lua_desync": [
        "fake:tcp_seq=-66000:tls_rnd:tls_dupsid:sni=www.google.com:repeats=8",
        "multisplit:pos=1:seqovl=681:pattern={bin}/tls_clienthello_www_google_com.bin:repeats=8"
      ]
    },
    {
      "name": "TCP 80,443",
      "filter-tcp": "80,443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake,multisplit",
      "dpi-desync-split-seqovl": "681",
      "dpi-desync-split-pos": "1",
      "dpi-desync-fooling": "badseq",
      "dpi-desync-badseq-increment": "10000000",
      "dpi-desync-repeats": "8",
      "dpi-desync-split-seqovl-pattern": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-tls-mod": "rnd,dupsid,sni=www.google.com",
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin",
      "lua_desync": [
        "fake:tcp_seq=-66000:tls_rnd:tls_dupsid:sni=www.google.com:http={bin}/tls_clienthello_max_ru.bin:repeats=8",
        "multisplit:pos=1:seqovl=681:pattern={bin}/tls_clienthello_www_google_com.bin:repeats=8"
      ]
    },
    {
      "name": "IPSet UDP 443",
      "filter-udp": "443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=11"
      ]
    },
    {
      "name": "IPSet TCP 80,443,8443",
      "filter-tcp": "80,443,8443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake,multisplit",
      "dpi-desync-split-seqovl": "681",
      "dpi-desync-split-pos": "1",
      "dpi-desync-fooling": "badseq",
      "dpi-desync-badseq-increment": "10000000",
      "dpi-desync-repeats": "8",
      "dpi-desync-split-seqovl-pattern": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-tls-mod": "rnd,dupsid,sni=www.google.com",
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin",
      "lua_desync": [
        "fake:tcp_seq=-66000:tls_rnd:tls_dupsid:sni=www.google.com:http={bin}/tls_clienthello_max_ru.bin:repeats=8",
        "multisplit:pos=1:seqovl=681:pattern={bin}/tls_clienthello_www_google_com.bin:repeats=8"
      ]
    }
  ]
}
