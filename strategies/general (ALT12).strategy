{
  "id": "general (ALT12)",
  "name": "General (ALT12)",
  "description": "Hybrid: Discord fake,multisplit; Google hostfakesplit; general fake,multisplit.",
  "version": "1.0",
  "author": "vesno4null",
  "wf_tcp": "80,443,2053,2083,2087,2096,8443",
  "wf_udp": "443,19294-19344,50000-50100",
  "rules": [
    {
      "name": "UDP 443",
      "filter-udp": "443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=11"
      ]
    },
    {
      "name": "UDP 19294-19344,50000-50100",
      "filter-udp": "19294-19344,50000-50100",
      "filter-l7": "discord,stun",
      "dpi-desync": "fake",
      "dpi-desync-fake-discord": [
        "{bin}/stun.bin",
        "{bin}/ACTIVE_DISCORD_UDP.bin"
      ],
      "dpi-desync-fake-stun": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-repeats": "3",
      "lua_desync": [
        "fake:discord={bin}/stun.bin&{bin}/ACTIVE_DISCORD_UDP.bin:stun={bin}/ACTIVE_DISCORD_UDP.bin:repeats=3"
      ]
    },
    {
      "name": "TCP 2053,2083,2087,2096,8443",
      "filter-tcp": "2053,2083,2087,2096,8443",
      "hostlist-domains": "discord.media",
      "dpi-desync": "fake,multisplit",
      "dpi-desync-split-seqovl": "681",
      "dpi-desync-split-pos": "1",
      "dpi-desync-fooling": "ts",
      "dpi-desync-repeats": "8",
      "dpi-desync-split-seqovl-pattern": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin",
      "lua_desync": [
        "fake:tcp_ts_up:tls={bin}/tls_clienthello_www_google_com.bin:repeats=8",
        "multisplit:pos=1:seqovl=681:pattern={bin}/tls_clienthello_www_google_com.bin:repeats=8"
      ]
    },
    {
      "name": "TCP 443",
      "filter-tcp": "443",
      "hostlist": "{lists}/list-google.txt",
      "ip-id": "zero",
      "dpi-desync": "hostfakesplit",
      "dpi-desync-fooling": "ts",
      "dpi-desync-hostfakesplit-mod": "host=www.google.com",
      "lua_desync": [
        "hostfakesplit:tcp_ts_up"
      ]
    },
    {
      "name": "TCP 80,443",
      "filter-tcp": "80,443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake,multisplit",
      "dpi-desync-split-seqovl": "664",
      "dpi-desync-split-pos": "1",
      "dpi-desync-fooling": "ts",
      "dpi-desync-repeats": "8",
      "dpi-desync-split-seqovl-pattern": "{bin}/tls_clienthello_max_ru.bin",
      "dpi-desync-fake-tls": [
        "{bin}/stun.bin",
        "{bin}/tls_clienthello_max_ru.bin"
      ],
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin",
      "lua_desync": [
        "fake:tcp_ts_up:tls={bin}/stun.bin&{bin}/tls_clienthello_max_ru.bin:http={bin}/tls_clienthello_max_ru.bin:repeats=8",
        "multisplit:pos=1:seqovl=664:pattern={bin}/tls_clienthello_max_ru.bin:repeats=8"
      ]
    },
    {
      "name": "IPSet UDP 443",
      "filter-udp": "443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=11"
      ]
    },
    {
      "name": "IPSet TCP 80,443,8443",
      "filter-tcp": "80,443,8443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake,multisplit",
      "dpi-desync-split-seqovl": "664",
      "dpi-desync-split-pos": "1",
      "dpi-desync-fooling": "ts",
      "dpi-desync-repeats": "8",
      "dpi-desync-split-seqovl-pattern": "{bin}/tls_clienthello_max_ru.bin",
      "dpi-desync-fake-tls": [
        "{bin}/stun.bin",
        "{bin}/tls_clienthello_max_ru.bin"
      ],
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin",
      "lua_desync": [
        "fake:tcp_ts_up:tls={bin}/stun.bin&{bin}/tls_clienthello_max_ru.bin:http={bin}/tls_clienthello_max_ru.bin:repeats=8",
        "multisplit:pos=1:seqovl=664:pattern={bin}/tls_clienthello_max_ru.bin:repeats=8"
      ]
    }
  ]
}
