{
  "id": "general (MULTISPLIT)",
  "name": "General (MULTISPLIT)",
  "description": "Pure multisplit with seqovl. Multiple split positions for maximum DPI evasion.",
  "version": "1.0",
  "author": "vesno4null",
  "wf_tcp": "80,443,2053,2083,2087,2096,8443",
  "wf_udp": "443,19294-19344,50000-50100",
  "rules": [
    {
      "name": "UDP 443",
      "filter-udp": "443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "8",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=8"
      ]
    },
    {
      "name": "UDP 19294-19344,50000-50100",
      "filter-udp": "19294-19344,50000-50100",
      "filter-l7": "discord,stun",
      "dpi-desync": "fake",
      "dpi-desync-fake-discord": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-fake-stun": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-repeats": "4",
      "lua_desync": [
        "fake:discord={bin}/ACTIVE_DISCORD_UDP.bin:stun={bin}/ACTIVE_DISCORD_UDP.bin:repeats=4"
      ]
    },
    {
      "name": "TCP 2053,2083,2087,2096,8443",
      "filter-tcp": "2053,2083,2087,2096,8443",
      "hostlist-domains": "discord.media",
      "dpi-desync": "multisplit",
      "dpi-desync-split-seqovl": "681",
      "dpi-desync-split-pos": "1,midsld",
      "dpi-desync-fooling": "ts",
      "dpi-desync-repeats": "6",
      "lua_desync": [
        "multisplit:pos=1,midsld:seqovl=681:repeats=6"
      ]
    },
    {
      "name": "TCP 443",
      "filter-tcp": "443",
      "hostlist": "{lists}/list-google.txt",
      "ip-id": "zero",
      "dpi-desync": "multisplit",
      "dpi-desync-split-seqovl": "652",
      "dpi-desync-split-pos": "2",
      "dpi-desync-fooling": "ts",
      "dpi-desync-repeats": "6",
      "lua_desync": [
        "multisplit:pos=2:seqovl=652:repeats=6"
      ]
    },
    {
      "name": "TCP 80,443",
      "filter-tcp": "80,443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "multisplit",
      "dpi-desync-split-seqovl": "652",
      "dpi-desync-split-pos": "2",
      "dpi-desync-fooling": "ts",
      "dpi-desync-repeats": "6",
      "lua_desync": [
        "multisplit:pos=2:seqovl=652:repeats=6"
      ]
    },
    {
      "name": "IPSet UDP 443",
      "filter-udp": "443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "8",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=8"
      ]
    },
    {
      "name": "IPSet TCP 80,443,8443",
      "filter-tcp": "80,443,8443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "multisplit",
      "dpi-desync-split-seqovl": "652",
      "dpi-desync-split-pos": "2",
      "dpi-desync-fooling": "ts",
      "dpi-desync-repeats": "6",
      "lua_desync": [
        "multisplit:pos=2:seqovl=652:repeats=6"
      ]
    }
  ]
}
