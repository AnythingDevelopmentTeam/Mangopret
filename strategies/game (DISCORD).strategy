{
  "id": "game (DISCORD)",
  "name": "Game (DISCORD)",
  "description": "Optimized for Discord voice/video. Aggressive QUIC fake + low-latency UDP handling.",
  "version": "1.0",
  "author": "vesno4null",
  "wf_tcp": "80,443,2053,2083,2087,2096,8443",
  "wf_udp": "443,19294-19344,50000-50100",
  "rules": [
    {
      "name": "UDP 443 QUIC",
      "filter-udp": "443",
      "filter-l7": "quic",
      "hostlist-domains": "discord.com,discord.gg,discord.media,discordapp.com,discordapp.net",
      "dpi-desync": "fake",
      "dpi-desync-repeats": "15",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=15"
      ]
    },
    {
      "name": "UDP 19294-19344 Discord Voice",
      "filter-udp": "19294-19344",
      "filter-l7": "discord,unknown",
      "dpi-desync": "fake",
      "dpi-desync-fake-discord": [
        "{bin}/ACTIVE_DISCORD_UDP.bin",
        "{bin}/ACTIVE_GAME_UDP.bin"
      ],
      "dpi-desync-fake-unknown-udp": [
        "{bin}/ACTIVE_DISCORD_UDP.bin",
        "{bin}/ACTIVE_GAME_UDP.bin"
      ],
      "dpi-desync-repeats": "8",
      "lua_desync": [
        "fake:discord={bin}/ACTIVE_DISCORD_UDP.bin&{bin}/ACTIVE_GAME_UDP.bin:repeats=8"
      ]
    },
    {
      "name": "UDP 50000-50100 Discord Alt",
      "filter-udp": "50000-50100",
      "filter-l7": "discord,stun,unknown",
      "dpi-desync": "fake",
      "dpi-desync-fake-discord": [
        "{bin}/ACTIVE_DISCORD_UDP.bin",
        "{bin}/ACTIVE_GAME_UDP.bin"
      ],
      "dpi-desync-fake-stun": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-fake-unknown-udp": "{bin}/ACTIVE_GAME_UDP.bin",
      "dpi-desync-repeats": "8",
      "lua_desync": [
        "fake:discord={bin}/ACTIVE_DISCORD_UDP.bin&{bin}/ACTIVE_GAME_UDP.bin:stun={bin}/ACTIVE_DISCORD_UDP.bin:repeats=8"
      ]
    },
    {
      "name": "TCP 2053,2083,2087,2096,8443 Discord Media",
      "filter-tcp": "2053,2083,2087,2096,8443",
      "hostlist-domains": "discord.media",
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fooling": "ts",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin",
      "lua_desync": [
        "fake:tcp_ts_up:tls={bin}/tls_clienthello_www_google_com.bin:repeats=11"
      ]
    },
    {
      "name": "TCP 443 Discord",
      "filter-tcp": "443",
      "hostlist-domains": "discord.com,discord.gg,discord.media,discordapp.com,discordapp.net",
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fooling": "ts",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin",
      "lua_desync": [
        "fake:tcp_ts_up:tls={bin}/tls_clienthello_www_google_com.bin:repeats=11"
      ]
    },
    {
      "name": "TCP 80,443 General fallback",
      "filter-tcp": "80,443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "6",
      "dpi-desync-fooling": "ts",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin",
      "lua_desync": [
        "fake:tcp_ts_up:tls={bin}/tls_clienthello_www_google_com.bin:http={bin}/tls_clienthello_max_ru.bin:repeats=6"
      ]
    },
    {
      "name": "IPSet UDP 443",
      "filter-udp": "443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin",
      "lua_desync": [
        "fake:quic={bin}/quic_initial_www_google_com.bin:repeats=11"
      ]
    },
    {
      "name": "IPSet TCP 80,443,8443",
      "filter-tcp": "80,443,8443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "6",
      "dpi-desync-fooling": "ts",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin",
      "lua_desync": [
        "fake:tcp_ts_up:tls={bin}/tls_clienthello_www_google_com.bin:http={bin}/tls_clienthello_max_ru.bin:repeats=6"
      ]
    }
  ]
}
