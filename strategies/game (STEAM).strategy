{
  "id": "game (STEAM)",
  "name": "Game (STEAM)",
  "description": "Optimized for Steam. Game downloads, voice chat, and store access.",
  "version": "1.0",
  "author": "vesno4null",
  "wf_tcp": "80,443,2053,2083,2087,2096,8443",
  "wf_udp": "443,19294-19344,27015-27050,50000-50100",
  "rules": [
    {
      "name": "UDP 443 QUIC",
      "filter-udp": "443",
      "filter-l7": "quic",
      "hostlist-domains": "steamcommunity.com,steampowered.com,steamgames.com,steamusercontent.com,steamcontent.com",
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fake-quic": "{bin}/quic_initial_steamcommunity_com.bin"
    },
    {
      "name": "UDP 27015-27050 Game Traffic",
      "filter-udp": "27015-27050",
      "filter-l7": "unknown,stun",
      "dpi-desync": "fake",
      "dpi-desync-fake-unknown-udp": "{bin}/ACTIVE_GAME_UDP.bin",
      "dpi-desync-fake-stun": "{bin}/ACTIVE_GAME_UDP.bin",
      "dpi-desync-repeats": "4"
    },
    {
      "name": "UDP 19294-19344,50000-50100 Discord",
      "filter-udp": "19294-19344,50000-50100",
      "filter-l7": "discord,stun",
      "dpi-desync": "fake",
      "dpi-desync-fake-discord": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-fake-stun": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-repeats": "6"
    },
    {
      "name": "TCP 443 Steam",
      "filter-tcp": "443",
      "hostlist-domains": "steamcommunity.com,steampowered.com,steamgames.com,steamusercontent.com,steamcontent.com",
      "dpi-desync": "fake",
      "dpi-desync-repeats": "8",
      "dpi-desync-fooling": "ts",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin"
    },
    {
      "name": "TCP 80,443 General",
      "filter-tcp": "80,443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "6",
      "dpi-desync-fooling": "ts",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin"
    },
    {
      "name": "IPSet UDP 443",
      "filter-udp": "443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "11",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin"
    },
    {
      "name": "IPSet TCP 80,443,8443",
      "filter-tcp": "80,443,8443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "6",
      "dpi-desync-fooling": "ts",
      "dpi-desync-fake-tls": "{bin}/tls_clienthello_www_google_com.bin",
      "dpi-desync-fake-http": "{bin}/tls_clienthello_max_ru.bin"
    }
  ]
}
