{
  "id": "general (ALT5)",
  "name": "General (ALT5)",
  "description": "Syndata+multidisorder, IPv4 only. Minimal config, no per-hostlist splitting.",
  "version": "1.0",
  "author": "Mangopret",
  "wf_tcp": "80,443,2053,2083,2087,2096,8443",
  "wf_udp": "443,19294-19344,50000-50100",
  "rules": [
    {
      "name": "UDP 443",
      "filter-udp": "443",
      "hostlist": [
        "{lists}/list-general.txt",
        "{lists}/list-general-user.txt"
      ],
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "6",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin"
    },
    {
      "name": "UDP 19294-19344,50000-50100",
      "filter-udp": "19294-19344,50000-50100",
      "filter-l7": "discord,stun",
      "dpi-desync": "fake",
      "dpi-desync-fake-discord": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-fake-stun": "{bin}/ACTIVE_DISCORD_UDP.bin",
      "dpi-desync-repeats": "6"
    },
    {
      "name": "L3 ipv4",
      "filter-l3": "ipv4",
      "filter-tcp": "80,443,2053,2083,2087,2096,8443",
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "syndata,multidisorder"
    },
    {
      "name": "IPSet TCP {game_filter_tcp}",
      "filter-tcp": "{game_filter_tcp}",
      "ipset": "{lists}/ipset-all.txt",
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "syndata,multidisorder",
      "dpi-desync-any-protocol": "1",
      "dpi-desync-cutoff": "n4"
    },
    {
      "name": "IPSet UDP 443",
      "filter-udp": "443",
      "ipset": "{lists}/ipset-all.txt",
      "hostlist-exclude": [
        "{lists}/list-exclude.txt",
        "{lists}/list-exclude-user.txt"
      ],
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "6",
      "dpi-desync-fake-quic": "{bin}/quic_initial_www_google_com.bin"
    },
    {
      "name": "IPSet UDP {game_filter_udp}",
      "filter-udp": "{game_filter_udp}",
      "ipset": "{lists}/ipset-all.txt",
      "ipset-exclude": [
        "{lists}/ipset-exclude.txt",
        "{lists}/ipset-exclude-user.txt"
      ],
      "dpi-desync": "fake",
      "dpi-desync-repeats": "14",
      "dpi-desync-any-protocol": "1",
      "dpi-desync-fake-unknown-udp": "{bin}/ACTIVE_GAME_UDP.bin",
      "dpi-desync-cutoff": "n3"
    }
  ]
}
